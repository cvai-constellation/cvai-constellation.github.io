{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cvai-chat-gateway",
  "pages_build_output_dir": "public",
  "compatibility_date": "2026-09-11",
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom",
        "script_name": "cvai-constellation-chat"
      }
    ]
  }
}
