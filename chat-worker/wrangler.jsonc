{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cvai-constellation-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },
  "exports": {
    "ChatRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
